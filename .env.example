# Copia este archivo como .env en esta misma carpeta. Reinicia npm start.
# Opcional: sin clave se consulta el servicio público directo de NASA CCMC.
NASA_API_KEY=

# Multijugador: generar con npm run firebase:configure, nunca pegar claves en dist.
FIREBASE_WEB_CONFIG=
FIREBASE_SERVICE_ACCOUNT_BASE64=
